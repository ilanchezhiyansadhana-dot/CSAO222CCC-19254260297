
#include <stdio.h>

int digitalRoot(int n)
{
    if (n < 10)
        return n;

    int sum = 0;

    while (n > 0)
    {
        sum += n % 10;
        n /= 10;
    }

    return digitalRoot(sum);
}

int power(int base, int n)
{
    if (n == 0)
        return 1;

    int half = power(base, n / 2);

    if (n % 2 == 0)
        return half * half;

    return base * half * half;
}

int main()
{
    printf("Digital Root = %d\n", digitalRoot(9875));
    printf("Power = %d\n", power(2, 5));

    return 0;
}

